ENV=dev
LOG_LEVEL=INFO
JWT_SECRET_KEY=change_this_to_a_secure_random_string_for_jwt

# --- DATABASE (RDS PostgreSQL free tier in AWS; local: docker-compose postgres) ---
DATABASE_URL=postgresql+asyncpg://ragadmin:changeme@localhost:5432/rag_db

# --- CACHE (Redis in K3s: redis://redis-svc:6379/0) ---
REDIS_URL=redis://localhost:6379/0

# --- VECTOR DB (Qdrant — in-cluster DNS qdrant-svc; Ray on EC2 host often uses 127.0.0.1:30633) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_collection

# --- GRAPH DB (Neo4j AuraDB Free in prod) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- AWS (use terraform output s3_bucket_name; keys from IAM user) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=replace-with-terraform-output-s3_bucket_name

# --- LLM (Groq free tier) ---
GROQ_API_KEY=

# --- OBSERVABILITY (OTLP disabled on free tier; CloudWatch collects stdout) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- TOOLS ---
TAVILY_API_KEY=
